# Copy this file to .env and fill in real values. Never commit .env.
#
# amg loads .env from the current directory if present, but real
# environment variables always take precedence over .env contents.

# --- Single-environment commands (inventory, snapshot, doctor) ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# --- Two-environment commands (preflight, verify) ---
# "source" is the environment you are migrating FROM.
AMG_SOURCE_ENDPOINT=https://cloud.appwrite.io/v1
AMG_SOURCE_PROJECT_ID=
AMG_SOURCE_API_KEY=

# "destination" is the environment you are migrating TO.
AMG_DEST_ENDPOINT=https://appwrite.example.com/v1
AMG_DEST_PROJECT_ID=
AMG_DEST_API_KEY=
